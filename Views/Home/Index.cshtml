@model IEnumerable<Product>

@{
    ViewData["Title"] = "محصولات";
    var products = Model?.ToList() ?? new List<Product>();
    var featured = products.Take(4).ToList();
}

<section class="hero">
    <div class="hero-inner">
        <div class="hero-content">
            <h1 class="hero-title font-display">خرید روزانه، تحویل در <span class="hero-highlight">کمتر از 60 دقیقه</span></h1>
            <p class="hero-desc">میوه، سبزی، لبنیات و خواربار روزانه؛ تازه، با قیمت مناسب و تحویل سریع به درب منزل شما.</p>
            <div class="hero-actions">
                <a href="#all-products" class="btn btn-success btn-lg">مشاهده محصولات</a>
            </div>
        </div>
        <div class="hero-visual">
            <svg viewBox="0 0 460 420" class="hero-illustration" role="img"
                aria-labelledby="heroTitle heroDesc" xmlns="http://www.w3.org/2000/svg">
            <title id="heroTitle">سبد میوه و سبزیجات تازه</title>
            <desc id="heroDesc">یک سبد حصیری پر از سیب سبز، سیب سرخ، پرتقال، لیمو و خوشه انگور</desc>

            <defs>
                <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#F7FCF8"/>
                <stop offset="1" stop-color="#E8F5EC"/>
                </linearGradient>

                <linearGradient id="basketGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#249356"/>
                <stop offset="1" stop-color="#145934"/>
                </linearGradient>

                <linearGradient id="rimGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2E8F52"/>
                <stop offset="1" stop-color="#0F4326"/>
                </linearGradient>

                <linearGradient id="handleGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#A9713A"/>
                <stop offset="0.5" stop-color="#8B5A2B"/>
                <stop offset="1" stop-color="#6B3F1D"/>
                </linearGradient>

                <radialGradient id="greenAppleGrad" cx="35%" cy="30%" r="75%">
                <stop offset="0" stop-color="#79D18F"/>
                <stop offset="0.55" stop-color="#3FA35F"/>
                <stop offset="1" stop-color="#1E7A46"/>
                </radialGradient>

                <radialGradient id="redAppleGrad" cx="35%" cy="28%" r="75%">
                <stop offset="0" stop-color="#F78C7C"/>
                <stop offset="0.55" stop-color="#D64545"/>
                <stop offset="1" stop-color="#A92F2F"/>
                </radialGradient>

                <radialGradient id="orangeGrad" cx="35%" cy="28%" r="75%">
                <stop offset="0" stop-color="#F9C46B"/>
                <stop offset="0.55" stop-color="#E2932F"/>
                <stop offset="1" stop-color="#B5701C"/>
                </radialGradient>

                <radialGradient id="lemonGrad" cx="35%" cy="28%" r="75%">
                <stop offset="0" stop-color="#FFE98A"/>
                <stop offset="0.55" stop-color="#F2C230"/>
                <stop offset="1" stop-color="#C99A18"/>
                </radialGradient>

                <radialGradient id="grapeGrad" cx="35%" cy="28%" r="75%">
                <stop offset="0" stop-color="#B99ADB"/>
                <stop offset="0.55" stop-color="#7C5AA6"/>
                <stop offset="1" stop-color="#55377A"/>
                </radialGradient>

                <filter id="softShadow" x="-20%" y="-20%" width="140%" height="140%">
                <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#145934" flood-opacity="0.18"/>
                </filter>

                <filter id="fruitShadow" x="-30%" y="-30%" width="160%" height="160%">
                <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#0F4326" flood-opacity="0.18"/>
                </filter>

                <clipPath id="basketClip">
                <path d="M110 215 L145 372 Q230 396 315 372 L350 215 Z"/>
                </clipPath>
            </defs>

            <ellipse cx="230" cy="215" rx="195" ry="185" fill="url(#bg)"/>
            <ellipse cx="230" cy="400" rx="150" ry="14" fill="#DCE6DF"/>

            <g fill="none" stroke-linecap="round">
                <path d="M172 215 C172 95 288 95 288 215" stroke="#6B3F1D" stroke-width="14"/>
                <path d="M172 215 C172 95 288 95 288 215" stroke="url(#handleGrad)" stroke-width="10"/>
                <path d="M180 205 C182 115 278 115 280 205" stroke="#C08A54" stroke-width="3" opacity="0.55"/>
            </g>

            <g id="fruits" filter="url(#fruitShadow)">
                <g>
                <circle cx="140" cy="200" r="36" fill="url(#greenAppleGrad)"/>
                <path d="M140 164 q4 -16 18 -14" fill="none" stroke="#186238" stroke-width="3" stroke-linecap="round"/>
                <path d="M140 168 q-2 -14 -16 -12 q0 16 16 12 Z" fill="#2E8F52"/>
                <ellipse cx="128" cy="188" rx="10" ry="14" fill="#FFFFFF" opacity="0.22" transform="rotate(-25 128 188)"/>
                </g>

                <g>
                <circle cx="200" cy="192" r="40" fill="url(#redAppleGrad)"/>
                <path d="M200 152 q6 -18 22 -13 q-4 17 -22 13 Z" fill="#2E8F52"/>
                <path d="M200 154 q0 -12 -10 -16" fill="none" stroke="#7A3B1E" stroke-width="3" stroke-linecap="round"/>
                <ellipse cx="184" cy="178" rx="11" ry="15" fill="#FFFFFF" opacity="0.22" transform="rotate(-30 184 178)"/>
                </g>

                <g>
                <circle cx="272" cy="180" r="46" fill="url(#orangeGrad)"/>
                <path d="M272 134 q0 -10 12 -12" fill="none" stroke="#B5701C" stroke-width="3" stroke-linecap="round"/>
                <ellipse cx="254" cy="164" rx="13" ry="17" fill="#FFFFFF" opacity="0.18" transform="rotate(-28 254 164)"/>
                </g>

                <g>
                <ellipse cx="333" cy="205" rx="34" ry="30" fill="url(#lemonGrad)"/>
                <path d="M333 175 q6 -10 16 -8" fill="none" stroke="#B5701C" stroke-width="3" stroke-linecap="round"/>
                <ellipse cx="320" cy="194" rx="9" ry="12" fill="#FFFFFF" opacity="0.24" transform="rotate(-30 320 194)"/>
                </g>
            </g>

            <g id="basket" filter="url(#softShadow)">
                <path d="M110 215 L145 372 Q230 396 315 372 L350 215 Z" fill="url(#basketGrad)"/>

                <g clip-path="url(#basketClip)" stroke="#0F4326" stroke-width="4" opacity="0.35" stroke-linecap="round">
                <line x1="134" y1="264" x2="150" y2="365"/>
                <line x1="172" y1="264" x2="181" y2="372"/>
                <line x1="211" y1="264" x2="213" y2="376"/>
                <line x1="250" y1="264" x2="247" y2="376"/>
                <line x1="289" y1="264" x2="279" y2="372"/>
                <line x1="327" y1="264" x2="310" y2="365"/>
                <path d="M124 286 Q230 302 336 286" fill="none"/>
                <path d="M130 324 Q230 342 330 324" fill="none"/>
                <path d="M136 356 Q230 374 324 356" fill="none"/>
                </g>

                <path d="M110 215 L350 215 L336 246 L124 246 Z" fill="url(#rimGrad)"/>
                <path d="M118 219 L342 219" stroke="#4CAF6B" stroke-width="4" stroke-linecap="round" opacity="0.7"/>
            </g>

            <g id="grapes" filter="url(#fruitShadow)">
                <path d="M350 228 q4 -14 18 -12" fill="none" stroke="#2E8F52" stroke-width="3" stroke-linecap="round"/>
                <g fill="url(#grapeGrad)">
                <circle cx="352" cy="255" r="13"/>
                <circle cx="368" cy="268" r="13"/>
                <circle cx="352" cy="281" r="13"/>
                <circle cx="336" cy="268" r="13"/>
                <circle cx="358" cy="240" r="11"/>
                </g>
                <g fill="#FFFFFF" opacity="0.35">
                <circle cx="348" cy="251" r="3"/>
                <circle cx="364" cy="264" r="3"/>
                <circle cx="348" cy="277" r="3"/>
                <circle cx="332" cy="264" r="3"/>
                </g>
            </g>
            </svg>
        </div>
    </div>
</section>

<section class="trust-bar">
    <div class="row no-gutters">
        <div class="col-6 col-md-3">
            <span class="trust-icon">
                <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg>
            </span>
            <span class="trust-text">ارسال سریع در تهران</span>
        </div>
        <div class="col-6 col-md-3">
            <span class="trust-icon">
                <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            </span>
            <span class="trust-text">پرداخت امن و مطمئن</span>
        </div>
        <div class="col-6 col-md-3">
            <span class="trust-icon">
                <svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10" /><polyline points="1 20 1 14 7 14" /><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" /></svg>
            </span>
            <span class="trust-text">ضمانت بازگشت وجه</span>
        </div>
        <div class="col-6 col-md-3">
            <span class="trust-icon">
                <svg viewBox="0 0 24 24"><path d="M3 18v-6a9 9 0 0 1 18 0v6" /><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z" /></svg>
            </span>
            <span class="trust-text">پشتیبانی ۲۴ ساعته</span>
        </div>
    </div>
</section>

<div class="container mt-5" id="all-products">

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            @await Component.InvokeAsync("Categories")
        </div>


        <!-- Products -->
        <div class="col-lg-9">

            <div class="row g-4">

                @foreach(var item in products)
                {
                    <partial name="_Product" model="item" />
                }

            </div>

        </div>

    </div>

</div>
